# Copy to .env for local evaluation. Never commit .env or real keys.

# Runtime configuration.
DATABASE_URL=sqlite:///./doc_ingest.db
REDIS_URL=redis://localhost:6379/0
# background | celery (background avoids Redis in CI and local tests)
QUEUE_BACKEND=background
WEBHOOK_URL=

# Parser routing.
PARSER_TIMEOUT_SECONDS=120
CONFIDENCE_THRESHOLD=0.6
MONTHLY_PAGE_QUOTA=500

# Aliyun pay-as-you-go OCR (scanned-document/overflow route only).
ALIYUN_OCR_KEY=
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=

# Billing provider is stubbed in M1 batch 1.
STRIPE_API_KEY=

# Optional higher-limit key for anydoc hosted OCR smoke tests.
FIRECRAWL_API_KEY=
