# Copy to .env for local evaluation. Never commit .env or real keys.

# Runtime configuration.
DATABASE_URL=sqlite:///./doc_ingest.db
REDIS_URL=redis://localhost:6379/0
# background | celery (background avoids Redis in CI and local tests)
QUEUE_BACKEND=background
WEBHOOK_URL=

# Parser routing.
PARSER_TIMEOUT_SECONDS=120
CONFIDENCE_THRESHOLD=0.6
MONTHLY_PAGE_QUOTA=500

# Aliyun pay-as-you-go OCR (scanned-document/overflow route only).
ALIYUN_OCR_KEY=
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=

# Billing: mock provider in M1 batch 3; real Stripe integration planned for M2.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional higher-limit key for anydoc hosted OCR smoke tests.
FIRECRAWL_API_KEY=

# Paddle billing (M2 batch 3). Empty PADDLE_ENV = mock billing (M1 behaviour).
PADDLE_ENV=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER=pri_01m4knr3h18h4vvw1bsc02q2rd
PADDLE_PRICE_PRO=pri_01m4knr3np11s8zqzgzt8df74q